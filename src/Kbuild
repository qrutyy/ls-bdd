ccflags-y := 	-Wall							\
		-Wextra									\
		-Wno-missing-field-initializers			\
		-Wno-unused-parameter					\
		-Wformat								\
		-std=gnu18								\
		-O2 									\
		-Werror=format-security					\
		-Werror=implicit-function-declaration   \

obj-m := lsv.o

# Lock-free hash table implementation: make ht=<name> (default dta)
ht ?= dta
HT_DIR := utils/lock-free/ht_$(ht)

ifeq ($(ht), dta)
lsv-ht-impl := $(HT_DIR)/dta.o $(HT_DIR)/ht_dta.o
lsv-ht-impl-tests := $(HT_DIR)/tests/suites/kunit_lsv_dta_reg.o
else
$(error Invalid ht specified. Use "make ht=dta")
endif

lsv-ht := utils/wq.o $(lsv-ht-impl)
# The suites every implementation runs, compiled against the one picked
# through its tests/ht_impl_test.h, and the cases of its own mechanism.
lsv-ht-tests := utils/lock-free/ht_tests/lsv_kunit_ht.o \
	utils/lock-free/ht_tests/suites/kunit_lsv_ht_reg.o \
	utils/lock-free/ht_tests/suites/kunit_lsv_ht_stress.o \
	utils/lock-free/ht_tests/suites/kunit_lsv_ht_perf.o \
	$(HT_DIR)/tests/ht_impl_test.o \
	$(lsv-ht-impl-tests)

ifeq ($(type), lf)
DIR := utils/lock-free
ccflags-y += -DLF_MODE
ccflags-y += -DLSV_HT_IMPL_H='"$(HT_DIR)/ht_$(ht).h"' -I$(src)/$(HT_DIR)/tests
lsv-objs := $(DIR)/lf_list.o $(lsv-ht)

# KUnit suites of the hash table, in lsv.ko whenever the kernel has KUnit
ifneq ($(CONFIG_KUNIT),)
lsv-objs += $(lsv-ht-tests)
endif

else ifeq ($(type), sy)
DIR := utils/sync
ccflags-y += -DSY_MODE
lsv-objs := $(DIR)/hashtable.o

else
$(error Invalid type specified. Use "make type=lf" or "make type=sy")
endif

lsv-ds := utils/ds_control.o utils/xxh3.o \
	$(DIR)/btree_utils.o $(DIR)/skiplist.o \
	$(DIR)/rbtree.o

lsv-objs += main.o ctl/configfs.o core/dev.o \
	core/lmap/lmap.o core/bio/bio.o core/bio/io.o core/dedup/dedup.o core/dedup/digest.o \
	$(lsv-ds)

# Add dynamical include path for the ds-control headers.
ccflags-y += -I$(src) -I$(src)/$(DIR)
