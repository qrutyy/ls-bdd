ccflags-y := 	-Wall							\
		-Wextra									\
		-Wno-missing-field-initializers			\
		-Wno-unused-parameter					\
		-Wformat								\
		-std=gnu18								\
		-O2 									\
		-Werror=format-security					\
		-Werror=implicit-function-declaration   \

obj-m := lsv.o

# Lock-free hash table implementation: make ht=<name> (default dta)
#   dta   DtA: reclamation with recovery of stalled participants
#   ebr   EBR, limbo lists of every participant its own
#   ebr+  EBR, three limbo lists shared by the whole table
ht ?= dta
HT_DIR := utils/lock-free/ht_$(ht)

ifeq ($(ht), dta)
HT_HDR := $(HT_DIR)/ht_dta.h
lsv-ht-impl := $(HT_DIR)/dta.o $(HT_DIR)/ht_dta.o
lsv-ht-impl-tests := $(HT_DIR)/tests/suites/kunit_lsv_dta_reg.o
else ifeq ($(ht), ebr)
HT_HDR := $(HT_DIR)/ht_ebr.h
lsv-ht-impl := $(HT_DIR)/ebr.o $(HT_DIR)/ht_ebr.o $(HT_DIR)/ebr_local.o
lsv-ht-impl-tests := $(HT_DIR)/tests/suites/kunit_lsv_ebr_reg.o
else ifeq ($(ht), ebr+)
# the table and the epochs are the ones of ebr, only the limbo lists differ
HT_HDR := utils/lock-free/ht_ebr/ht_ebr.h
ccflags-y += -DLSV_HT_EBR_GLOBAL
lsv-ht-impl := utils/lock-free/ht_ebr/ebr.o utils/lock-free/ht_ebr/ht_ebr.o \
	$(HT_DIR)/ebr_global.o
lsv-ht-impl-tests := utils/lock-free/ht_ebr/tests/suites/kunit_lsv_ebr_reg.o
else
$(error Invalid ht specified. Use "make ht=dta", "make ht=ebr" or "make ht=ebr+")
endif

# The workers the hash table participants run on
lsv-wq := core/wq/shard_wq.o core/wq/pool_wq.o core/wq/wq.o

lsv-ht := $(lsv-wq) $(lsv-ht-impl)
# The suites every implementation runs, compiled against the one picked
# through its tests/ht_impl_test.h, and the cases of its own mechanism.
lsv-ht-tests := utils/lock-free/ht_tests/lsv_kunit_ht.o \
	utils/lock-free/ht_tests/suites/kunit_lsv_ht_reg.o \
	utils/lock-free/ht_tests/suites/kunit_lsv_ht_stress.o \
	utils/lock-free/ht_tests/suites/kunit_lsv_ht_perf.o \
	$(HT_DIR)/tests/ht_impl_test.o \
	$(lsv-ht-impl-tests)

ifeq ($(type), lf)
DIR := utils/lock-free
ccflags-y += -DLF_MODE
ccflags-y += -DLSV_HT_IMPL_H='"$(HT_HDR)"' -I$(src)/$(HT_DIR)/tests
lsv-objs := $(DIR)/lf_list.o $(lsv-ht)

# KUnit suites of the hash table, in lsv.ko whenever the kernel has KUnit
ifneq ($(CONFIG_KUNIT),)
lsv-objs += $(lsv-ht-tests)
endif

else ifeq ($(type), sy)
DIR := utils/sync
ccflags-y += -DSY_MODE
lsv-objs := $(DIR)/hashtable.o

else
$(error Invalid type specified. Use "make type=lf" or "make type=sy")
endif

lsv-ds := utils/ds_control.o utils/xxh3.o \
	$(DIR)/btree_utils.o $(DIR)/skiplist.o \
	$(DIR)/rbtree.o

lsv-objs += main.o ctl/configfs.o core/dev.o \
	core/lmap/lmap.o core/bio/bio.o core/bio/io.o core/dedup/dedup.o core/dedup/digest.o \
	$(lsv-ds)

# Add dynamical include path for the ds-control headers.
ccflags-y += -I$(src) -I$(src)/$(DIR)
