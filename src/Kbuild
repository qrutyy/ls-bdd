ccflags-y := 	-Wall					\
		-Wextra					\
		-Wno-missing-field-initializers		\
		-Wno-unused-parameter			\
		-Wformat				\
		-std=gnu18				\
		-O2 \
		-Werror=format-security			\
		-Werror=implicit-function-declaration   \

obj-m := lsbdd.o

ifeq ($(type), lf)
DIR := utils/lock-free
ccflags-y += -DLF_MODE
lsbdd-objs := $(DIR)/lf_list.o
else ifeq ($(type), sy)
DIR := utils/sync
ccflags-y += -DSY_MODE
else
$(error Invalid type specified. Use "make type=lf" or "make type=sy")
endif

# The hash table of the blocking build: a spinlock per bucket (default) or an
# OPTIK lock per bucket (see utils/sync/optik.h).
ifeq ($(type), sy)
ifeq ($(ht), optik)
ccflags-y += -DHT_OPTIK
else ifneq ($(filter-out bucket,$(ht)),)
$(error Invalid ht specified. Use "make type=sy ht=bucket" or "make type=sy ht=optik")
endif
endif

lsbdd-objs += main.o utils/ds_control.o \
	$(DIR)/btree_utils.o $(DIR)/skiplist.o \
	$(DIR)/hashtable.o $(DIR)/rbtree.o  \

# Add dynamical include path for the ds-control headers.
ccflags-y += -I$(PWD)/$(DIR)


